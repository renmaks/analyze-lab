    ),
    driver="GeoJSON",
    encoding="utf-8"
)


def format_rubles(value):
    if pd.isna(value):
        return ""

    return (
        f"{value:,.0f} ₽"
        .replace(",", " ")
    )


display_columns = [
    "rank",
    "Наименование",
    "ИНН",
    "revenue",
    "average_annual_revenue",
    "bfo_address",
    "geocode_status",
    "geocode_precision"
]


display(
    top500_geocoded[
        display_columns
    ]
    .head(20)
    .style
    .format({
        "revenue": format_rubles,
        "average_annual_revenue":
            format_rubles
    })
)

# %% [markdown]
# Карта показывает компании из топ-500 по суммарной выручке за весь доступный период только среди организаций с полной отчетностью за каждый год периода.<br>
# Компании без полной пятилетней отчетности исключаются до ранжирования, поэтому рейтинг не является безусловным топ-500 всей исходной отраслевой выборки.<br>
# Компании, для которых координаты не найдены, на карту не попадают. При `geocode_precision = settlement` точка соответствует населенному пункту, а не точному адресу организации.<br>
# Большое абсолютное число точек в Москве, Санкт-Петербурге или другом регионе не означает более высокую прибыльность компаний региона. Для регионального сравнения дополнительно рассчитываются медианная суммарная выручка и доля компаний региона, вошедших в топ-500.
